# =============================================================================
# ROS1 Horizon SLAM — Переменные окружения
# =============================================================================
# Скопируйте этот файл в .env и заполните реальными значениями:
#   cp .env.example .env
# =============================================================================

# --- Сеть ---
# IP адрес Raspberry Pi 5
PI5_IP=192.168.123.100

# IP адрес хост-машины (для RViz)
HOST_IP=192.168.123.1

# IP адрес Livox Horizon лидара
LIDAR_IP=192.168.123.51

# --- Livox ---
# Broadcast code с наклейки лидара (формат: XXXXXXXXXXXXXXX)
LIVOX_BROADCAST_CODE=3WEDH5900101971

# --- ROS ---
# ROS Master URI
ROS_MASTER_URI=http://192.168.123.100:11311

# ROS IP (обычно совпадает с PI5_IP)
ROS_IP=192.168.123.100

# --- SLAM параметры ---
# Мёртвая зона лидара (метры)
BLIND=1.0

# Прореживание точек
POINT_FILTER_NUM=2

# Размер вокселя карты
FILTER_SIZE_MAP=0.15

# Дальность обнаружения (метры)
DET_RANGE=100

# Плотная публикация
DENSE_PUBLISH_EN=true

# Сохранение PCD
PCD_SAVE_EN=true

# Интервал сохранения PCD (количество точек)
PCD_SAVE_INTERVAL=200

# --- Дисплей (для RViz) ---
# DISPLAY=:0

# --- Node-RED ---
# Порт Node-RED
NODE_RED_PORT=1880

# --- TheBigBrother (OSINT) ---
# Порт OSINT сервиса
OSINT_PORT=8000

common:
  lid_topic: /livox/lidar
  imu_topic: /livox/imu
  time_sync_en: true
  time_offset_lidar_to_imu: 0.0
preprocess:
  lidar_type: 1
  scan_line: 6
  blind: 1.0
  point_filter_num: 2
mapping:
  filter_size_map: 0.15
  acc_cov: 0.1
  gyr_cov: 0.01
  b_acc_cov: 0.0001
  b_gyr_cov: 0.0001
  fov_degree: 50
  det_range: 100
  extrinsic_est_en: false
  extrinsic_T:
  - 0
  - 0
  - 0
  extrinsic_R:
  - 1
  - 0
  - 0
  - 0
  - 1
  - 0
  - 0
  - 0
  - 1
publish:
  path_en: true
  scan_publish_en: true
  dense_publish_en: true
  scan_bodyframe_pub_en: true
pcd_save:
  pcd_save_en: true
  interval: 200
